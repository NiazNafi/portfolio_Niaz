# ── Portfolio environment ──────────────────────────────────────────────────
#
# You do not need this file. The site is a static build: content comes from
# content/source.mjs, every asset is committed to this repository, and
# `npm run build` produces a dist/ folder that deploys anywhere with no server
# and no database.
#
# Everything below turns on the OPTIONAL content API in server/, which lets the
# CV be edited in a Supabase table instead of in the source file. It is wired up
# and working, but it is switched off — nothing here is set, so nothing calls it.
# See "The dormant backend" in README.md before turning it on.
#
# To use it: copy this to .env and fill in what you need.

# ── the client ─────────────────────────────────────────────────────────────
# Where the browser revalidates its built-in content snapshot from.
#
# LEAVE THIS BLANK to skip the network call entirely, which is the default and
# the intended state. The page renders from the bundle either way; setting this
# only adds the ability to see a database edit without redeploying.
VITE_API_URL=

# ── the optional API ───────────────────────────────────────────────────────
PORT=8787

# The Supabase project holding the portfolio_* tables. Without these the API
# still runs and still serves correct content — it falls back to the same
# snapshot the client already has.
#
# The anon / publishable key is enough. Those tables carry a select-only RLS
# policy and no write policy at all, so there is nothing this key can damage.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only for `node --env-file=.env scripts/db-push.mjs`, which writes content into
# the tables. Bypasses row level security entirely, so it must never gain a
# VITE_ prefix and must never reach the browser bundle.
SUPABASE_SECRET_KEY=

# Origins allowed to call the API, comma separated. Only needed for a split
# deploy (client on Netlify, API elsewhere). Blank = same-origin only.
ALLOWED_ORIGINS=
